[Unit]
Description=Mod player daemon (libopenmpt direct)
After=sound.target

[Service]
Type=simple
User=__USER__
Group=__USER__
SupplementaryGroups=audio gpio
WorkingDirectory=__HOME__
ExecStart=__HOME__/mod_player/.venv/bin/python __HOME__/mod_player/mod_playerd.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
